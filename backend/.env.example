# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=protrack_auto
DB_USER=postgres
DB_PASSWORD=postgres
DB_URL=postgresql://postgres:postgres@localhost:5432/protrack_auto

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production

# SMTP Configuration (For real emails)
# If using Gmail, you MUST generate an "App Password" (do NOT use your real password)
# 1. Go to your Google Account Security settings
# 2. Enable 2-Step Verification
# 3. Create an "App Password" and paste it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
