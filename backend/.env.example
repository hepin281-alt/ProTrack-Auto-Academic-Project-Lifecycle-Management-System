# Server Configuration
PORT=5001
NODE_ENV=development

# CORS — set ONE of these (FRONTEND_URL is preferred; CORS_ORIGIN is the legacy alias)
# In Render dashboard, add:  FRONTEND_URL=https://pro-track-auto-academic-project-lif.vercel.app
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# Production (Render/Neon/RDS): set DATABASE_URL; the pool will use SSL automatically.
# Local: leave DATABASE_URL blank and fill in the individual fields below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=protrack_auto
DB_USER=postgres
DB_PASSWORD=postgres
DB_URL=postgresql://postgres:postgres@localhost:5432/protrack_auto

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production

# SMTP Configuration (For real emails)
# If using Gmail, you MUST generate an "App Password" (do NOT use your real password)
# 1. Go to your Google Account Security settings
# 2. Enable 2-Step Verification
# 3. Create an "App Password" and paste it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# HuggingFace Token (for SBERT ML model loading without rate limits)
# Get a free token at: https://huggingface.co/settings/tokens
# Required for ml_service to run without network warnings
HF_TOKEN=your-huggingface-token-here
